{
  "name": "melody-tab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "src/",
    "server/",
    "scripts/",
    "public/device-access.js",
    "public/test-melody.wav",
    "index.html",
    "chords.html",
    "vite.config.js",
    "render.yaml",
    "start-youtube-helper.cmd",
    "CHANGELOG.md"
  ],
  "scripts": {
    "postinstall": "node scripts/copy-model.mjs && node scripts/copy-tesseract.mjs",
    "dev": "vite",
    "build": "vite build",
    "package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "preview": "vite preview",
    "start": "node server/index.js",
    "helper": "node server/helper.js",
    "home": "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File scripts/home-server.ps1",
    "setup:youtube": "node scripts/setup-youtube.mjs",
    "setup:guitar": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-guitar.ps1",
    "test": "node --test \"src/*.test.js\" \"src/chords/*.test.js\" \"server/*.test.js\""
  },
  "dependencies": {
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "^3.13.0",
    "tesseract.js": "^7.0.0",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "vite": "^5.4.0"
  }
}
